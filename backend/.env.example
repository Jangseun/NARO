# .env.example → 이 파일을 복사해서 .env 파일을 만들고 값을 채워 주세요.
# (.env 파일은 비밀번호와 API 키가 들어 있으므로 git에 올리지 않습니다)

# AI API 키. 비워 두면 '데모 모드'로 동작합니다. (실제 AI 대신 정해진 규칙으로 질문/피드백 생성)
#
# [무료] Google Gemini 사용 (https://aistudio.google.com 에서 키 발급, 카드 등록 불필요)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash
#
# [유료] OpenAI 사용 시: 위 세 줄 대신 아래처럼 (OPENAI_BASE_URL은 비우거나 지우기)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# 로그인 계정 (서버를 처음 실행할 때 DB에 계정이 만들어집니다)
# 계정을 바꾸려면 naro.db 파일을 지우고 서버를 다시 실행하세요.
NARO_USERNAME=naro
NARO_PASSWORD=naro1234

# USB 웹캠 번호 (보통 0)
WEBCAM_INDEX=0
# 라즈베리파이 카메라를 거꾸로 설치했다면 1
CAMERA_ROTATE_180=0
